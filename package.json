{
  "name": "remotion-presets-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "dev": "npm run dev -w @remotion-presets/studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "audit:effects": "node scripts/audit-canvas-effects.mjs",
    "render:representative": "node scripts/render-representative-presets.mjs",
    "test": "vitest run",
    "test:package": "node scripts/smoke-package.mjs",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:package -- --skip-build"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
